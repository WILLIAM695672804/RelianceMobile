# Émulateur Android : l'hôte est joignable en 10.0.2.2 ; appareil physique : IP locale de la machine.
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=http://10.0.2.2:8010
EXPO_PUBLIC_WS_HOST=10.0.2.2
EXPO_PUBLIC_WS_PORT=6001
EXPO_PUBLIC_WS_KEY=reliance-key
# À ajouter dans SANCTUM_STATEFUL_DOMAINS du backend (sans schéma) : mobile.reliance.local
EXPO_PUBLIC_STATEFUL_ORIGIN=http://mobile.reliance.local

# Démarre sur le prototype navigable de la refonte (données d'exemple, sans serveur).
# EXPO_PUBLIC_PROTOTYPE=1
